{
  "name": "game-trend-radar",
  "version": "4.0.0",
  "private": true,
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "vue-tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "publish:static": "node scripts/publish-static.mjs",
    "test": "node --test tests/*.test.cjs",
    "test:frontend": "node --import tsx --test tests/frontend-*.test.mjs",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "vue": "3.5.43"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@types/node": "24.10.1",
    "@vitejs/plugin-vue": "6.0.9",
    "sirv": "3.0.2",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vite": "8.3.3",
    "vue-tsc": "3.3.12"
  }
}
